{
  "name": "@cal-hacks/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Convex backend (queries, mutations, actions, HTTP actions, file storage, vector search)",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "typecheck": "tsc -p convex/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cal-hacks/shared": "workspace:*",
    "convex": "^1.47.0",
    "zod": "^4.6.7"
  }
}
