# This file is a template. Put real values in .env.local and never commit them.

# --- Local development (npx convex dev fills these in .env.local automatically) ---
# Convex deployment identifier (example: dev:happy-animal-123)
CONVEX_DEPLOYMENT=
# URL the frontend uses to reach Convex (use the prefix that matches the frontend framework: VITE_ / NEXT_PUBLIC_)
VITE_CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
# Frontend chat panel: set to "convex" to use the backend chatbot instead of the built-in demo answers
VITE_CHAT_BACKEND=
# How long the chat waits for an answer, in milliseconds (default 30000). A model on your own computer needs more, for example 120000.
VITE_CHAT_TIMEOUT_MS=

# --- Convex server environment variables (set in the Convex dashboard or with `npx convex env set`, not here) ---
# Needed for the chatbot. Never put them in code or .env.local.
# Speech-to-text (Cartesia): npx convex env set CARTESIA_API_KEY <your key>
# CARTESIA_API_KEY=
# Chatbot language model (any OpenAI-compatible API; the free default is Groq with openai/gpt-oss-20b):
# npx convex env set LLM_API_KEY <your key>
# npx convex env set LLM_BASE_URL https://api.groq.com/openai/v1   (optional)
# npx convex env set LLM_MODEL openai/gpt-oss-20b                   (optional)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# Fully local alternative (Llama through Ollama, no API key). See docs/local-llm.md:
# npx convex env set LLM_PROVIDER local
# LLM_PROVIDER=
# Local-only privacy mode blocks cloud voice input unless you opt in:
# npx convex env set ALLOW_CLOUD_STT true
# ALLOW_CLOUD_STT=
# LLM_API_KEY=
# LLM_MODEL=

# Viewing progress (SpacetimeDB, optional; the website works without it). Set in apps/frontend/.env.local:
# VITE_SPACETIME_URI=ws://127.0.0.1:3000
# VITE_SPACETIME_DB=ask-ray-progress
