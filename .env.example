# 이 파일은 템플릿이다. 실제 값은 .env.local 에 넣고 절대 커밋하지 않는다.

# --- 로컬 개발 (npx convex dev 가 .env.local 에 자동으로 채워준다) ---
# Convex 배포 식별자 (예: dev:happy-animal-123)
CONVEX_DEPLOYMENT=
# 프론트엔드가 Convex에 접속할 URL (프론트 프레임워크에 맞는 접두사 사용: VITE_ / NEXT_PUBLIC_)
VITE_CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# --- Convex 서버 환경변수 (여기가 아니라 Convex 대시보드 또는 `npx convex env set` 으로 설정) ---
# 챗봇 구현 단계에서 필요. 코드/.env.local 에 넣지 않는다.
# LLM_API_KEY=
# LLM_MODEL=
