# Default Convex deployment for local development (`pnpm dev:frontend`). It is not a secret.
# It is the shared dev deployment of the hack-13 project, so sign-up and login work without any setup.
# To use your own deployment, set VITE_CONVEX_URL in apps/frontend/.env.local (that file wins over this one).
# To run without accounts (demo mode, walkthroughs open), delete the value below.
# Production builds (`pnpm build:frontend`) do not read this file; set VITE_CONVEX_URL in the host's build settings.
VITE_CONVEX_URL=https://benevolent-chinchilla-4.convex.cloud
